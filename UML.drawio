        <mxCell id="cMyString" value="&lt;div style='text-align:center'&gt;&lt;b&gt;MyString&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'/&gt;&lt;div&gt;- string : vector&amp;lt;char&amp;gt;&lt;/div&gt;&lt;div&gt;- len : int&lt;/div&gt;&lt;hr size='1'/&gt;&lt;div&gt;- isUpper(char) : bool&lt;/div&gt;&lt;div&gt;- isLower(char) : bool&lt;/div&gt;&lt;div&gt;- toUpper(char) : char&lt;/div&gt;&lt;div&gt;- toLower(char) : char&lt;/div&gt;&lt;div&gt;+ MyString()&lt;/div&gt;&lt;div&gt;+ MyString(const char*)&lt;/div&gt;&lt;div&gt;+ MyString(const MyString&amp;amp;)&lt;/div&gt;&lt;div&gt;+ operator=(const MyString&amp;amp;) : MyString&amp;amp;&lt;/div&gt;&lt;div&gt;+ operator=(const char*) : MyString&amp;amp;&lt;/div&gt;&lt;div&gt;+ length() : int&lt;/div&gt;&lt;div&gt;+ c_str() : const char*&lt;/div&gt;&lt;div&gt;+ empty() : bool&lt;/div&gt;&lt;div&gt;+ clear() : void&lt;/div&gt;&lt;div&gt;+ operator[](int) : char&amp;amp;&lt;/div&gt;&lt;div&gt;+ operator+=(const MyString&amp;amp;) : MyString&amp;amp;&lt;/div&gt;&lt;div&gt;+ operator+=(char) : MyString&amp;amp;&lt;/div&gt;&lt;div&gt;+ operator==(const MyString&amp;amp;) : bool&lt;/div&gt;&lt;div&gt;+ insertAt(int, char) : void&lt;/div&gt;&lt;div&gt;+ insertAt(int, const MyString&amp;amp;) : void&lt;/div&gt;&lt;div&gt;+ eraseAt(int, int) : void&lt;/div&gt;&lt;div&gt;+ substr(int, int) : MyString&lt;/div&gt;&lt;div&gt;+ find(const MyString&amp;amp;, int) : int&lt;/div&gt;&lt;div&gt;+ toggleCaseChar(int) : void&lt;/div&gt;&lt;div&gt;+ replaceAll(const MyString&amp;amp;, const MyString&amp;amp;) : MyString&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
